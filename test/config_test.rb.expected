--- the nearest .sumi.json decides the base, however deep the run starts ---
app/billing: base=../.. root=../../.spec
  verify: glossary=false behavior=true contract=true
project: base=. root=.spec
  verify: glossary=false behavior=true contract=true
--- with no .sumi.json, the repository it sits in ---
repo/lib: base=.. root=../.spec
  verify: glossary=true behavior=true contract=true
--- with neither, where the run started ---
loose: base=. root=.spec
  verify: glossary=true behavior=true contract=true
--- a .sumi.json that will not parse is not a difference ---
.sumi.json is not readable JSON
--- a value no key takes stops the run, and every one of them answers ---
.sumi.json writes root as 123, where it takes a path
.sumi.json writes exclude as "target/", where it takes a list of paths
.sumi.json writes gitignore as "no", where it takes true or false
.sumi.json writes budget as 25, where it takes the limits to measure
--- a key no configuration says stops the run too ---
.sumi.json writes exlude, which is not something a configuration says
.sumi.json writes rot, which is not something a configuration says
--- switching a specification by a name, a word or a value nothing reads ---
.sumi.json sets verify on behavior as "false", where it takes true or false
.sumi.json sets verfiy on contract, which is not something contract is switched by
.sumi.json switches glosary, which is no specification this sumi carries
--- what the project excludes ---
  app/order.rb: false
  target/debug/generated.rb: true
  a project that said nothing excludes nothing: []
--- and what its .gitignore already said ---
  vendor/gem.rb: true
  vendor/kept.rb, put back by .sumi.json: false
  switched off: false
--- a specification switched by a word of its own ---
  order: behavior=false verify: behavior=true
  a project that said nothing: true
--- a word set on a specification that does not take it, or to what it does not take ---
.sumi.json sets order on behavior as "no", where it takes true or false
.sumi.json sets order on contract, which is not something contract is switched by
--- a budget limits what it writes a number for ---
  sentence=25 paragraph=nil
  a project that said nothing: sentence=nil paragraph=nil
--- a limit nothing measures, or one that is no whole number above zero ---
.sumi.json sets words on budget, which is not something a budget limits
.sumi.json sets sentence on budget as 0, where it takes a whole number above zero
.sumi.json sets paragraph on budget as "six", where it takes a whole number above zero
