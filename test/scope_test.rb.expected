--- where a walk starts ---
  app/**/*.rb -> ["app"]
  app/*.rb app/billing/*.rb -> ["app"]
  **/*.rb -> [""]
  top.rb -> []
  docs/*.md app/**/*.rb top.rb -> ["app", "docs"]
--- a root under another root is dropped ---
  ["app", "docs"]
--- what a walk from the base reaches ---
  app/billing/charge.rb app/order.rb docs/guide.md top.rb
--- a root nothing wrote ---
  []
--- a directory the walk refuses ---
  reached: app/order.rb docs/guide.md top.rb
  refused: ["app/billing"]
  billing/*.rb emptied by the project: true
  nowhere/*.rb nobody could have meant: false
--- what an include covers ---
  app/billing/charge.rb app/order.rb top.rb
  app/order.rb top.rb
  app/billing/charge.rb
